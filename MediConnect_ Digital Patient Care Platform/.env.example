# Required database settings; use your local credentials in .env
# Server port defaults to 3000 if omitted
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_with_your_local_password
DB_DATABASE=mediconnect
# JWT secret must contain at least 32 non-padding characters
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
