# Required database settings; use your local credentials in .env
# Server port defaults to 3000 if omitted
PORT=3000
DB_HOST=localhost
DB_PORT=5432
# Set true for Neon connections; automatic schema synchronization is disabled with SSL
DB_SSL=false
DB_USERNAME=postgres
DB_PASSWORD=replace_with_your_local_password
DB_DATABASE=mediconnect
# JWT secret must contain at least 32 non-padding characters
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# SMTP: keep disabled until you enter your test SMTP credentials in .env
MAIL_ENABLED=false
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="MediConnect <noreply@example.com>"
